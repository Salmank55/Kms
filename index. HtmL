<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Free Kick Challenge</title>
  <style>
    :root {
      --grass-1: #0d5d2d;
      --grass-2: #0b4726;
      --line: rgba(255,255,255,0.9);
      --goal: #f3f5f7;
      --goal-wood: #d9d6d1;
      --gold: #ffcc33;
      --gold-deep: #ffb000;
      --dark: #0c1217;
      --panel: rgba(12, 18, 23, 0.72);
      --panel-border: rgba(255,255,255,0.14);
      --text: #eff7ff;
      --muted: #b8c1c9;
      --danger: #ff4d4d;
      --success: #6df2a1;
      --ball: #ffffff;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      height: 100%;
      font-family: Inter, Arial, sans-serif;
      background:
        radial-gradient(circle at top, rgba(255, 204, 51, 0.12), transparent 30%),
        linear-gradient(180deg, #081018 0%, #0b1420 100%);
      color: var(--text);
    }

    body {
      display: grid;
      place-items: center;
      min-height: 100vh;
      overflow: hidden;
    }

    .game-shell {
      width: min(1100px, 92vw);
      padding: 20px 20px 24px;
      border: 1px solid var(--panel-border);
      border-radius: 26px;
      background: rgba(11, 17, 22, 0.7);
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
      backdrop-filter: blur(8px);
    }

    .hud {
      display: flex;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 16px;
    }

    .score-box {
      min-width: 120px;
      padding: 12px 18px;
      text-align: center;
      background: var(--panel);
      border: 1px solid var(--panel-border);
      border-radius: 14px;
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.02);
    }

    .score-box span {
      display: block;
      color: var(--muted);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      margin-bottom: 6px;
    }

    .score-box strong {
      font-size: clamp(22px, 2vw, 32px);
      color: var(--gold);
      font-weight: 800;
    }

    .field {
      position: relative;
      width: 100%;
      height: 560px;
      overflow: hidden;
      border-radius: 26px;
      border: 3px solid rgba(255,255,255,0.15);
      background:
        linear-gradient(180deg, rgba(255,255,255,0.05), rgba(0,0,0,0.06)),
        linear-gradient(90deg, var(--grass-1), var(--grass-2));
      box-shadow: inset 0 0 0 2px rgba(0,0,0,0.18);
      user-select: none;
      touch-action: none;
    }

    .field::before,
    .field::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .field::before {
      background:
        linear-gradient(to right, transparent 49.9%, rgba(255,255,255,0.25) 50%, transparent 50.1%),
        linear-gradient(to bottom, transparent 49.9%, rgba(255,255,255,0.15) 50%, transparent 50.1%);
      background-size: 80px 80px;
      opacity: 0.15;
    }

    .field::after {
      background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.08) 50%, transparent 100%);
      opacity: 0.35;
    }

    .center-circle {
      position: absolute;
      width: 140px;
      height: 140px;
      border: 3px solid var(--line);
      border-radius: 50%;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      opacity: 0.9;
    }

    .penalty-box,
    .goal-box {
      position: absolute;
      border: 3px solid var(--line);
      background: rgba(255,255,255,0.02);
    }

    .penalty-box {
      left: 50%;
      top: 50%;
      width: 220px;
      height: 340px;
      transform: translate(-50%, -50%);
      border-left: 3px solid var(--line);
      border-right: 3px solid var(--line);
    }

    .goal-box {
      right: 26px;
      top: 50%;
      width: 128px;
      height: 220px;
      transform: translateY(-50%);
      border-left: none;
      border-radius: 0 14px 14px 0;
      background: rgba(255,255,255,0.03);
    }

    .goal-box::before {
      content: "";
      position: absolute;
      inset: 8px 0 8px 12px;
      border: 4px solid var(--goal);
      border-left: none;
      border-radius: 0 18px 18px 0;
      background: rgba(255,255,255,0.05);
      box-shadow: inset 0 0 0 2px rgba(255,255,255,0.1);
    }

    .goal-net {
      position: absolute;
      inset: 18px 12px 18px 8px;
      background: repeating-linear-gradient(
        90deg,
        rgba(255,255,255,0.16) 0,
        rgba(255,255,255,0.16) 1px,
        transparent 1px,
        transparent 12px
      );
      border-radius: 0 14px 14px 0;
      opacity: 0.34;
    }

    .spot {
      position: absolute;
      width: 14px;
      height: 14px;
      background: rgba(255,255,255,0.9);
      border-radius: 50%;
      left: 118px;
      top: 50%;
      transform: translateY(-50%);
      box-shadow: 0 0 0 4px rgba(255,255,255,0.14);
    }

    .keeper {
      position: absolute;
      width: 58px;
      height: 58px;
      right: 86px;
      top: 50%;
      transform: translateY(-50%);
      border-radius: 50%;
      background: linear-gradient(180deg, #f2f8ff 0%, #dce8f5 100%);
      box-shadow: inset -8px -10px 16px rgba(22,41,62,0.18), 0 16px 28px rgba(0,0,0,0.23);
      transition: top 0.08s linear;
      z-index: 6;
    }

    .keeper::before {
      content: "";
      position: absolute;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #202a33;
      left: 22px;
      top: 17px;
      box-shadow: 0 0 0 3px rgba(255,255,255,0.2);
    }

    .keeper::after {
      content: "";
      position: absolute;
      width: 44px;
      height: 16px;
      left: 7px;
      top: 34px;
      border-radius: 10px;
      background: linear-gradient(180deg, #d4e1f0, #bfcfe1);
      box-shadow: inset 0 -4px 0 rgba(0,0,0,0.06);
    }

    .ball {
      position: absolute;
      width: 26px;
      height: 26px;
      left: 112px;
      top: 50%;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      background:
        radial-gradient(circle at 35% 35%, #ffffff 0%, #f4f7fb 18%, #dfe9ef 30%, #d1d9df 100%);
      border: 3px solid rgba(0,0,0,0.12);
      box-shadow: inset -8px -8px 12px rgba(0,0,0,0.14), 0 10px 18px rgba(0,0,0,0.28);
      z-index: 7;
    }

    .ball::before {
      content: "";
      position: absolute;
      inset: 5px;
      border-radius: 50%;
      border: 2px solid rgba(0,0,0,0.15);
    }

    .ball::after {
      content: "";
      position: absolute;
      left: 50%;
      top: 50%;
      width: 2px;
      height: 2px;
      border-radius: 50%;
      background: rgba(0,0,0,0.35);
      transform: translate(-50%, -50%);
      box-shadow: 0 0 0 2px rgba(255,255,255,0.18);
    }

    .aim-line {
      position: absolute;
      width: 90px;
      height: 2px;
      background: linear-gradient(90deg, rgba(255,255,255,0.24), rgba(255,255,255,0.8));
      transform-origin: left center;
      opacity: 0.75;
      pointer-events: none;
      z-index: 5;
    }

    .aim-dot {
      position: absolute;
      width: 10px;
      height: 10px;
      background: rgba(255, 204, 51, 0.95);
      border-radius: 50%;
      box-shadow: 0 0 0 6px rgba(255,204,51,0.18);
      pointer-events: none;
      z-index: 6;
    }

    .power-panel {
      position: absolute;
      left: 50%;
      bottom: 24px;
      transform: translateX(-50%);
      width: min(360px, 74%);
      padding: 12px 14px 14px;
      border-radius: 16px;
      background: rgba(12,18,23,0.64);
      border: 1px solid rgba(255,255,255,0.12);
      z-index: 9;
    }

    .power-label {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
      color: var(--muted);
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .power-bar {
      position: relative;
      width: 100%;
      height: 18px;
      background: rgba(255,255,255,0.08);
      border-radius: 999px;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,0.08);
    }

    .power-fill {
      position: absolute;
      left: 0;
      top: 0;
      width: 0%;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, #ffdf6b, #ffb000, #ff7a00);
      box-shadow: 0 0 24px rgba(255,176,0,0.5);
      transition: width 0.05s linear;
    }

    .message {
      position: absolute;
      top: 16px;
      left: 50%;
      transform: translateX(-50%);
      padding: 10px 18px;
      border-radius: 999px;
      background: rgba(9, 15, 20, 0.7);
      border: 1px solid rgba(255,255,255,0.08);
      color: var(--text);
      font-size: 12px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      z-index: 12;
      white-space: nowrap;
    }

    .message.goal {
      color: #dfffe8;
      border-color: rgba(109, 242, 161, 0.42);
      box-shadow: 0 0 20px rgba(109, 242, 161, 0.18);
    }

    .message.save {
      color: #ffe9a9;
      border-color: rgba(255, 204, 51, 0.4);
      box-shadow: 0 0 18px rgba(255,204,51,0.18);
    }

    @media (max-width: 720px) {
      .game-shell {
        width: min(94vw, 560px);
        padding: 14px 14px 18px;
      }

      .field {
        height: 440px;
      }

      .penalty-box {
        width: 170px;
        height: 240px;
      }

      .goal-box {
        width: 96px;
        height: 170px;
      }

      .keeper {
        right: 62px;
      }

      .ball {
        left: 75px;
      }

      .spot {
        left: 82px;
      }
    }
  </style>
</head>
<body>
  <div class="game-shell">
    <div class="hud">
      <div class="score-box">
        <span>Score</span>
        <strong id="score">0</strong>
      </div>
      <div class="score-box">
        <span>Best</span>
        <strong id="best">0</strong>
      </div>
      <div class="score-box">
        <span>Shots</span>
        <strong id="shots">0</strong>
      </div>
    </div>

    <div class="field" id="field">
      <div class="center-circle"></div>
      <div class="penalty-box"></div>
      <div class="goal-box">
        <div class="goal-net"></div>
      </div>
      <div class="spot"></div>

      <div class="aim-line" id="aimLine"></div>
      <div class="aim-dot" id="aimDot"></div>
      <div class="keeper" id="keeper"></div>
      <div class="ball" id="ball"></div>

      <div class="message" id="message">Aim + hold to kick</div>

      <div class="power-panel">
        <div class="power-label">
          <span>Power</span>
          <span id="powerValue">0%</span>
        </div>
        <div class="power-bar">
          <div class="power-fill" id="powerFill"></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const field = document.getElementById('field');
    const ball = document.getElementById('ball');
    const keeper = document.getElementById('keeper');
    const scoreEl = document.getElementById('score');
    const bestEl = document.getElementById('best');
    const shotsEl = document.getElementById('shots');
    const powerFill = document.getElementById('powerFill');
    const powerValue = document.getElementById('powerValue');
    const aimLine = document.getElementById('aimLine');
    const aimDot = document.getElementById('aimDot');
    const message = document.getElementById('message');

    const state = {
      score: 0,
      best: 0,
      shots: 0,
      charging: false,
      power: 0,
      ballX: 112,
      ballY: 280,
      vx: 0,
      vy: 0,
      activeShot: false,
      pointerX: 0,
      pointerY: 0,
      lastShot: 0,
      swing: 0
    };

    function clamp(value, min, max) {
      return Math.min(Math.max(value, min), max);
    }

    function updateHud() {
      scoreEl.textContent = state.score;
      bestEl.textContent = state.best;
      shotsEl.textContent = state.shots;
      powerValue.textContent = Math.round(state.power * 100) + '%';
      powerFill.style.width = (state.power * 100) + '%';
    }

    function updateAimIndicator() {
      const rect = field.getBoundingClientRect();
      const x = clamp(state.pointerX, 32, rect.width - 32);
      const y = clamp(state.pointerY, 32, rect.height - 32);
      const ballX = state.ballX;
      const ballY = state.ballY;
      const dx = x - ballX;
      const dy = y - ballY;
      const angle = Math.atan2(dy, dx);
      const length = Math.hypot(dx, dy) || 1;
      const lineLen = clamp(length, 26, 140);

      aimLine.style.left = ballX + 'px';
      aimLine.style.top = ballY + 'px';
      aimLine.style.width = lineLen + 'px';
      aimLine.style.transform = 'rotate(' + angle + 'rad)';

      aimDot.style.left = x + 'px';
      aimDot.style.top = y + 'px';
    }

    function resetBall() {
      const rect = field.getBoundingClientRect();
      state.ballX = 112;
      state.ballY = rect.height / 2;
      ball.style.left = state.ballX + 'px';
      ball.style.top = state.ballY + 'px';
      state.vx = 0;
      state.vy = 0;
      state.activeShot = false;
      state.charging = false;
      state.power = 0;
      updateHud();
      updateAimIndicator();
    }

    function setMessage(str, type = '') {
      message.textContent = str;
      message.classList.remove('goal', 'save');
      if (type) message.classList.add(type);
    }

    function onPointerMove(event) {
      const rect = field.getBoundingClientRect();
      state.pointerX = event.clientX - rect.left;
      state.pointerY = event.clientY - rect.top;

      if (!state.activeShot && !state.charging) {
        updateAimIndicator();
      }
    }

    function startCharge() {
      if (state.activeShot) return;
      state.charging = true;
      state.power = 0;
      updateHud();
    }

    function chargePower() {
      if (!state.charging || state.activeShot) return;
      state.power = (state.power + 0.018) % 1;
      updateHud();
    }

    function shoot() {
      if (!state.charging || state.activeShot) return;

      state.charging = false;
      state.activeShot = true;
      state.shots += 1;
      updateHud();

      const dx = state.pointerX - state.ballX;
      const dy = state.pointerY - state.ballY;
      const distance = Math.hypot(dx, dy) || 1;
      const force = 7 + state.power * 18;

      state.vx = (dx / distance) * force;
      state.vy = (dy / distance) * force;

      setMessage('Shot taken!', '');
      updateAimIndicator();
    }

    function finishShot(result) {
      state.activeShot = false;
      state.vx = 0;
      state.vy = 0;
      state.power = 0;

      if (result === 'goal') {
        state.score += 1;
        state.best = Math.max(state.best, state.score);
        setMessage('GOAL! Brilliant finish!', 'goal');
      } else {
        setMessage('Saved by the keeper!', 'save');
      }

      updateHud();

      setTimeout(() => {
        resetBall();
        setMessage('Aim + hold to kick');
      }, 900);
    }

    function updateGoalkeeper(time) {
      const rect = field.getBoundingClientRect();
      const centerY = rect.height / 2;
      const sweep = Math.sin(time * 0.003) * 120;
      const top = centerY + sweep;
      keeper.style.top = clamp(top, 62, rect.height - 62) + 'px';
      keeper.style.left = (rect.width - 92) + 'px';
    }

    function animateFrame(time) {
      const rect = field.getBoundingClientRect();
      updateGoalkeeper(time);

      if (state.activeShot) {
        state.ballX += state.vx;
        state.ballY += state.vy;

        state.vx *= 0.992;
        state.vy *= 0.992;

        if (Math.abs(state.vx) < 0.12 && Math.abs(state.vy) < 0.12) {
          state.vx = 0;
          state.vy = 0;
          state.activeShot = false;
          setMessage('Off target. Try again!', '');
          setTimeout(() => {
            resetBall();
            setMessage('Aim + hold to kick');
          }, 500);
        }
      }

      if (state.ballX < 0 || state.ballY < 0 || state.ballY > rect.height) {
        state.ballX = clamp(state.ballX, 10, rect.width - 10);
      }

      ball.style.left = state.ballX + 'px';
      ball.style.top = state.ballY + 'px';

      const goalTop = rect.height / 2 - 110;
      const goalBottom = rect.height / 2 + 110;
      const keeperTop = parseFloat(keeper.style.top || (rect.height / 2) + 'px');
      const keeperCenter = keeperTop + 29;
      const goalX = rect.width - 24;

      if (state.activeShot && state.ballX > rect.width - 40 && state.ballY > goalTop && state.ballY < goalBottom) {
        const closeToKeeper = Math.abs(state.ballY - keeperCenter) < 28;
        if (closeToKeeper) {
          finishShot('save');
        } else {
          finishShot('goal');
        }
      }

      if (!state.activeShot && !state.charging && !state.lastShot) {
        updateAimIndicator();
      }

      requestAnimationFrame(animateFrame);
    }

    field.addEventListener('pointerdown', (event) => {
      if (state.activeShot) return;
      state.pointerX = event.clientX - field.getBoundingClientRect().left;
      state.pointerY = event.clientY - field.getBoundingClientRect().top;
      startCharge();
      updateAimIndicator();
    });

    field.addEventListener('pointermove', onPointerMove);
    field.addEventListener('pointerup', shoot);
    field.addEventListener('pointerleave', () => {
      if (state.charging) shoot();
    });

    window.addEventListener('pointerup', () => {
      if (state.charging) shoot();
    });

    setInterval(chargePower, 16);

    const rect = field.getBoundingClientRect();
    state.pointerX = 260;
    state.pointerY = rect.height / 2;
    resetBall();
    updateHud();
    updateAimIndicator();
    requestAnimationFrame(animateFrame);
  </script>
</body>
</html>
